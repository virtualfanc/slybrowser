# Public hosted PayNow product-page URLs. Create one recurring monthly product
# per paid plan. Never put a PayNow API key or webhook secret in Vite.
VITE_PAYNOW_LAUNCH_MONTHLY_URL=https://virtualbrowser.paynow.store/products/slybrowser-launch-monthly
VITE_PAYNOW_STUDIO_MONTHLY_URL=https://virtualbrowser.paynow.store/products/slybrowser-studio-monthly
VITE_PAYNOW_FLEET_MONTHLY_URL=https://virtualbrowser.paynow.store/products/slybrowser-fleet-monthly
VITE_PAYNOW_GRID_MONTHLY_URL=https://virtualbrowser.paynow.store/products/slybrowser-grid-monthly

# Optional public URLs.
VITE_SLY_API_ORIGIN=https://api.slybrowser.com
VITE_PAYNOW_SUBSCRIPTIONS_URL=https://checkout.paynow.gg/subscriptions
VITE_PAID_PREVIEW_URL=https://github.com/virtualfanc/slybrowser
