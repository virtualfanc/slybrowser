# Optional public hosted PayNow product-page URLs. The launch path uses the trusted
# server-side checkout-intent API; leave these empty unless a public hosted URL is
# explicitly approved for a non-production preview. Never put a PayNow API key or
# webhook secret in Vite.
VITE_PAYNOW_LAUNCH_MONTHLY_URL=
VITE_PAYNOW_STUDIO_MONTHLY_URL=
VITE_PAYNOW_FLEET_MONTHLY_URL=
VITE_PAYNOW_GRID_MONTHLY_URL=

# Optional public URLs.
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SLY_API_ORIGIN=https://api.slybrowser.com
VITE_PAYNOW_SUBSCRIPTIONS_URL=https://checkout.paynow.gg/subscriptions
VITE_PAID_PREVIEW_URL=https://github.com/virtualfanc/slybrowser

# Optional QA-only subscription. This is ignored in production builds and only shown
# when VITE_ENABLE_BILLING_QA=true in a non-production environment. PayNow rejected
# direct $0.10 and $0.51 product prices, so the test product uses a $1.00 base price
# with a $0.90 forever coupon.
VITE_ENABLE_BILLING_QA=false
VITE_PAYNOW_RECURRING_TEST_URL=
VITE_PAYNOW_RECURRING_TEST_PRICE=$0.10 / month
VITE_PAYNOW_RECURRING_TEST_COUPON=SLY10MONTHLY
