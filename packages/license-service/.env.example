SLY_RELEASE_MANIFEST_DIR=C:\sly\manifests
SLY_RELEASE_ARTIFACT_ROOT=C:\sly\artifacts
# Online short-lease signing key. Do not reuse this file/key ID for license-file or release-manifest signing.
SLY_LICENSE_SIGNING_KEY_FILE=C:\secrets\license-signing-private.pem
SLY_LICENSE_KEY_ID=license-prod-v1
SLY_LICENSE_KEY_PEPPER=replace-with-base64url-random-32-bytes-or-more
SLY_LICENSE_DB=C:\sly\state\license.sqlite
SLY_LICENSE_STORE=postgres
SLY_LICENSE_POSTGRES_URL=postgres://postgres:replace-with-local-password@127.0.0.1:5432/slybrowser_app
# Preferred license-admin RBAC credentials. Keep tokens in a real secret store.
SLY_LICENSE_ADMIN_CREDENTIALS_JSON=[{"token":"replace-with-license-issuer-token","actor":"license-issuer@slybrowser.example","permissions":["licenses:issue"]},{"token":"replace-with-license-updater-token","actor":"license-updater@slybrowser.example","permissions":["licenses:update"]}]
# Legacy local/dev fallback. Do not use as the final production admin model.
SLY_LICENSE_ADMIN_TOKEN=
SLY_LICENSE_HOST=127.0.0.1
SLY_LICENSE_PORT=8788
SLY_LICENSE_SESSION_TTL_SECONDS=660
SLY_LICENSE_HEARTBEAT_SECONDS=300

# Standalone PayNow billing webhook receiver (`billing-serve`).
SLY_PAYNOW_STORE_ID=replace-with-paynow-store-id
SLY_PAYNOW_API_KEY=replace-with-paynow-management-api-key
SLY_PAYNOW_API_BASE_URL=https://api.paynow.gg/v1
SLY_PAYNOW_API_TIMEOUT_MS=20000
SLY_PAYNOW_API_RATE_LIMIT_PER_MINUTE=120
SLY_PAYNOW_API_RATE_LIMIT_MAX_QUEUE=100
SLY_PAYNOW_WEBHOOK_SECRETS=replace-with-comma-separated-paynow-webhook-signing-secrets
SLY_PAYNOW_DB=C:\sly\state\paynow.sqlite
SLY_BILLING_STORE=postgres
SLY_BILLING_POSTGRES_URL=postgres://postgres:replace-with-local-password@127.0.0.1:5432/slybrowser_app
SLY_PAYNOW_HOST=127.0.0.1
SLY_PAYNOW_PORT=8787
SLY_BILLING_PUBLIC_ORIGIN=https://slybrowser.com
SLY_BILLING_GRACE_PERIOD_SECONDS=0
# Preferred billing-admin RBAC credentials. Keep tokens in a real secret store.
SLY_BILLING_ADMIN_CREDENTIALS_JSON=[{"token":"replace-with-support-admin-token","actor":"support@slybrowser.example","permissions":["orders:read","orders:note","orders:email","subscriptions:cancel"]},{"token":"replace-with-refund-admin-token","actor":"refunds@slybrowser.example","permissions":["orders:refund"]},{"token":"replace-with-license-ops-token","actor":"license-ops@slybrowser.example","permissions":["licenses:resend","licenses:rotate","licenses:update"]}]
# Legacy local/dev fallback. Do not use as the final production admin model.
SLY_BILLING_ADMIN_TOKEN=
SLY_BILLING_EMAIL_ENCRYPTION_KEY=replace-with-base64url-random-32-bytes
SLY_BILLING_EMAIL_HMAC_KEY=replace-with-base64url-random-32-bytes-or-more
SLY_LICENSE_FILE_SERVICE_URL=https://api.slybrowser.com
# License-file signing key. Must be distinct from SLY_LICENSE_SIGNING_KEY_FILE and SLY_LICENSE_KEY_ID.
SLY_LICENSE_FILE_SIGNING_KEY_FILE=C:\secrets\license-file-signing-private.pem
SLY_LICENSE_FILE_SIGNING_KEY_ID=license-file-private-preview-v1
SLY_LICENSE_FILE_PRIVATE_PREVIEW_PASSPHRASE=replace-with-private-preview-passphrase

# Server-side mailbox used for license delivery and user feedback.
# Production email system: Resend SMTP for outbound mail, Cloudflare Email Routing
# for inbound aliases and forwarding. Store the Resend API key only in the
# server-side SMTP password secret.
SLY_EMAIL_SMTP_HOST=smtp.resend.com
SLY_EMAIL_SMTP_PORT=587
SLY_EMAIL_SMTP_SECURE=false
SLY_EMAIL_SMTP_STARTTLS=true
SLY_EMAIL_SMTP_USER=resend
SLY_EMAIL_SMTP_PASSWORD=replace-with-resend-api-key
SLY_EMAIL_FROM=SlyBrowser <license@slybrowser.com>
SLY_EMAIL_SMTP_HELO=slybrowser.com
SLY_EMAIL_WEBHOOK_TOKEN=replace-with-random-email-provider-webhook-token
SLY_FEEDBACK_TO=feedback@slybrowser.com
SLY_FEEDBACK_SUBJECT_PREFIX=[SlyBrowser feedback]
SLY_FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=900
SLY_FEEDBACK_RATE_LIMIT_MAX_PER_IP=10
SLY_FEEDBACK_RATE_LIMIT_MAX_PER_EMAIL=3
SLY_FEEDBACK_RATE_LIMIT_MAX_PER_USER_AGENT=20
SLY_SUPPORT_EMAIL=support@slybrowser.com
# Optional operations alert fallback. In production this should point to the
# privately verified owner mailbox; keep the real personal address out of Git.
SLY_OPS_ALERT_EMAIL=replace-with-private-owner-mailbox
SLY_LICENSE_EMAIL_WORKER_LIMIT=20
SLY_LICENSE_EMAIL_MAX_ATTEMPTS=5
SLY_PAYNOW_PENDING_WORKER_LIMIT=20
SLY_PAYNOW_PENDING_MAX_ATTEMPTS=5
SLY_PAYNOW_RECONCILE_PAYMENT_LIMIT=100
SLY_PAYNOW_RECONCILE_SUBSCRIPTION_LIMIT=100

# Optional shared Redis backend for production cross-instance rate limits and short-lived queues.
SLY_REDIS_URL=redis://127.0.0.1:6379
SLY_LICENSE_RATE_LIMIT_REDIS_PREFIX=slybrowser:license-rate-limit
