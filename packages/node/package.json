{
  "name": "slybrowser",
  "version": "0.2.0",
  "description": "Node.js SDK for SlyBrowser",
  "type": "module",
  "license": "MIT",
  "homepage": "https://slybrowser.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtualfanc/slybrowser.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/virtualfanc/slybrowser/issues"
  },
  "keywords": [
    "slybrowser",
    "webdriver",
    "playwright",
    "puppeteer",
    "browser-automation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "slybrowser": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --config ../../eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "playwright-core": ">=1.62.0 <1.63.0",
    "puppeteer-core": ">=25.0.0 <26.0.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@types/node": "24.13.3",
    "@types/yauzl": "3.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
