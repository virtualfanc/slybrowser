{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/schemas/launch-options.schema.json",
  "title": "SlyBrowser launch options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "automationBackend": {
      "type": "string",
      "enum": ["project-webdriver", "playwright", "puppeteer"],
      "default": "project-webdriver"
    },
    "frameworkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "headless": { "type": "boolean", "default": true },
    "executablePath": { "type": "string", "minLength": 1 },
    "driverExecutable": { "type": "string", "minLength": 1 },
    "profileDir": { "type": "string", "minLength": 1 },
    "profileMode": { "type": "string", "enum": ["ephemeral", "persistent"], "default": "ephemeral" },
    "driverStartTimeout": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 15000 },
    "commandTimeout": { "type": "integer", "minimum": 1000, "maximum": 3600000, "default": 60000 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 240, "maximum": 16384 }
      }
    },
    "excludeSwitches": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": ["enable-automation", "enable-unsafe-swiftshader"]
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta", "canary"],
      "default": "stable"
    },
    "proxy": { "$ref": "#/$defs/proxy" },
    "proxyAlignment": { "$ref": "#/$defs/proxyAlignment" },
    "profile": { "$ref": "#/$defs/profile" },
    "args": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "humanize": { "type": "boolean", "default": false },
    "humanPreset": { "type": "string", "enum": ["default", "careful"], "default": "default" },
    "humanSeed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "humanConfig": { "$ref": "#/$defs/humanConfig" },
    "mobilePersona": { "$ref": "#/$defs/mobilePersona" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "humanConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mouseStepsMin": { "type": "integer", "minimum": 6, "maximum": 100 },
        "mouseStepsMax": { "type": "integer", "minimum": 6, "maximum": 100 },
        "mouseStepDelayMin": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mouseStepDelayMax": { "type": "integer", "minimum": 0, "maximum": 100 },
        "clickHoldMin": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "clickHoldMax": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "keyDelayMin": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "keyDelayMax": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "thinkDelayMin": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "thinkDelayMax": { "type": "integer", "minimum": 0, "maximum": 5000 }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server"],
      "properties": {
        "server": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "username": { "type": "string", "maxLength": 1024 },
        "password": { "type": "string", "maxLength": 1024, "writeOnly": true },
        "bypass": { "type": "string", "maxLength": 4096 },
        "failClosed": { "const": true, "default": true }
      }
    },
    "proxyAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "exitIp", "observedAt", "locale", "timezone", "geolocation"],
      "properties": {
        "source": { "type": "string", "enum": ["manual", "proxy-observer"] },
        "exitIp": {
          "oneOf": [
            { "type": "string", "format": "ipv4" },
            { "type": "string", "format": "ipv6" }
          ]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "locale": { "$ref": "#/$defs/locale" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/locale" }
        },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 128 },
        "geolocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "accuracy": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "integer", "minimum": -10, "maximum": 10 },
        "g": { "type": "integer", "minimum": -10, "maximum": 10 },
        "b": { "type": "integer", "minimum": -10, "maximum": 10 },
        "a": { "type": "integer", "minimum": -10, "maximum": 10 }
      }
    },
    "clientHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "version"],
      "properties": {
        "brand": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "mobilePersona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userAgent", "deviceMetrics", "clientHints"],
      "properties": {
        "userAgent": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "deviceMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "pixelRatio", "mobile", "touch"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 4096 },
            "height": { "type": "integer", "minimum": 240, "maximum": 4096 },
            "pixelRatio": { "type": "number", "minimum": 0.5, "maximum": 8 },
            "mobile": { "const": true },
            "touch": { "const": true }
          }
        },
        "clientHints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "mobile"],
          "properties": {
            "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
            "mobile": { "const": true },
            "brands": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/clientHint" } },
            "fullVersionList": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/clientHint" } },
            "platformVersion": { "type": "string", "maxLength": 64 },
            "architecture": { "type": "string", "maxLength": 64 },
            "model": { "type": "string", "maxLength": 128 },
            "bitness": { "type": "string", "maxLength": 16 },
            "wow64": { "type": "boolean" }
          }
        }
      }
    },
    "speechVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "lang", "localService", "name", "voiceURI"],
      "properties": {
        "default": { "type": "boolean" },
        "lang": { "$ref": "#/$defs/locale" },
        "localService": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "voiceURI": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "domain", "path", "session", "httpOnly", "secure", "sameSite"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "maxLength": 4096 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "session": { "type": "boolean" },
        "httpOnly": { "type": "boolean" },
        "secure": { "type": "boolean" },
        "sameSite": { "type": "string", "enum": ["None", "Lax", "Strict", "Unspecified"] }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userAgent": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "userAgentFullVersion": { "$ref": "#/$defs/nonEmptyString" },
        "clientHints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/clientHint" }
        },
        "osVersion": { "$ref": "#/$defs/nonEmptyString" },
        "locale": { "$ref": "#/$defs/locale" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/locale" }
        },
        "timezone": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["zone"],
              "properties": {
                "zone": { "type": "string", "minLength": 1, "maxLength": 128 },
                "utc": { "type": "string", "minLength": 1, "maxLength": 32 },
                "locale": { "$ref": "#/$defs/locale" }
              }
            }
          ]
        },
        "geolocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "accuracy": { "type": "number", "minimum": 0 },
            "permission": { "type": "string", "enum": ["ask", "allow", "block"], "default": "allow" }
          }
        },
        "screen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 240, "maximum": 16384 }
          }
        },
        "webrtc": {
          "oneOf": [
            { "type": "string", "enum": ["default", "proxy"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "ip"],
              "properties": {
                "mode": { "const": "replace" },
                "ip": { "type": "string", "minLength": 2, "maxLength": 45 }
              }
            }
          ],
          "default": "proxy"
        },
        "disabledFonts": {
          "type": "array",
          "maxItems": 1024,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "canvasNoise": { "$ref": "#/$defs/noise" },
        "webglImageNoise": { "$ref": "#/$defs/noise" },
        "webgl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "renderer"],
          "properties": {
            "vendor": { "type": "string", "minLength": 1, "maxLength": 512 },
            "renderer": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "webgpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "architecture"],
          "properties": {
            "vendor": { "type": "string", "minLength": 1, "maxLength": 256 },
            "architecture": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "audioContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "analyzer"],
          "properties": {
            "channel": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "analyzer": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          }
        },
        "disabledCipherSuites": {
          "type": "array",
          "maxItems": 1024,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true
        },
        "disabledMediaDevices": {
          "type": "array",
          "maxItems": 1024,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "clientRects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "minimum": -100, "maximum": 100 },
            "height": { "type": "number", "minimum": -100, "maximum": 100 }
          }
        },
        "speechVoices": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/speechVoice" }
        },
        "cookies": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/cookie" }
        },
        "hardwareConcurrency": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "deviceMemory": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "macAddress": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}([:-][0-9A-Fa-f]{2}){5}$"
        },
        "doNotTrack": { "type": "boolean" },
        "allowedPorts": {
          "type": "array",
          "maxItems": 1024,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "gpuEnabled": { "type": "boolean" },
        "homepages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    }
  }
}
