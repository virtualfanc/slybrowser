{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/schemas/automation-backends.schema.json",
  "title": "SlyBrowser automation backend compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lastVerified", "defaultBackend", "backends", "bindings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "defaultBackend": { "const": "project-webdriver" },
    "backends": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["project-webdriver", "playwright", "puppeteer"] },
      "contains": { "const": "project-webdriver" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "python", "java", "dotnet"],
      "properties": {
        "node": { "$ref": "#/$defs/language" },
        "python": { "$ref": "#/$defs/language" },
        "java": { "$ref": "#/$defs/language" },
        "dotnet": { "$ref": "#/$defs/language" }
      }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeVersions", "backends"],
      "properties": {
        "runtimeVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "backends": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/backend" }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "supportedLines", "nativeHumanize"],
      "properties": {
        "package": { "type": ["string", "null"] },
        "supportedLines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }
        },
        "nativeHumanize": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
