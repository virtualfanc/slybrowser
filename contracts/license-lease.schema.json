{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/schemas/license-lease.schema.json",
  "title": "SlyBrowser signed license lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "keyId", "payload", "signature"],
  "properties": {
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "payload": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 43692 },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 88 }
  },
  "$defs": {
    "leaseClaims": {
      "title": "Decoded Ed25519 lease payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "licenseId",
        "audience",
        "issuedAt",
        "notBefore",
        "expiresAt",
        "browserMin",
        "browserMax",
        "planId",
        "concurrencyLimit",
        "paidThrough",
        "licenseStatus",
        "artifactSha256",
        "browserSha256",
        "driverSha256",
        "leaseGeneration",
        "features",
        "sessionId",
        "nonce"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "licenseId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "audience": { "const": "slybrowser" },
        "issuedAt": { "type": "integer", "minimum": 0 },
        "notBefore": { "type": "integer", "minimum": 0 },
        "expiresAt": { "type": "integer", "minimum": 1 },
        "browserMin": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,7}$" },
        "browserMax": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,7}$" },
        "planId": { "enum": ["free", "basic", "pro", "max", "ultra"] },
        "concurrencyLimit": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "paidThrough": { "type": ["integer", "null"], "minimum": 0 },
        "licenseStatus": { "enum": ["active", "hold", "revoked"] },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "browserSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "driverSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "leaseGeneration": { "type": "integer", "minimum": 1 },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "nonce": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deviceHash": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
