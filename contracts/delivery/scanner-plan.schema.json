{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/contracts/delivery/scanner-plan.schema.json",
  "title": "SlyBrowser exact-index scanner plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "subject", "scanners"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "subject": { "const": "exact-staged-tree" },
    "scanners": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/scanner" }
    }
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "tool", "version", "scope", "parser", "network", "limitations"],
      "properties": {
        "id": {
          "enum": [
            "git-diff-check",
            "repository-guard",
            "typecheck",
            "lint",
            "sast",
            "dependency-vulnerability",
            "dependency-license"
          ]
        },
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["staged-diff", "exact-index"] },
        "parser": { "type": "string", "minLength": 1 },
        "network": { "enum": ["none", "required"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
