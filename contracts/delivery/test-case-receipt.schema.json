{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/contracts/delivery/test-case-receipt.schema.json",
  "title": "SlyBrowser binding test case receipt",
  "type": "object",
  "required": ["schemaVersion", "caseId", "binding", "level", "candidateId", "status", "observedAt", "subject", "evidenceDigest", "tool", "command", "assertions", "negativeCanary", "rawEvidence", "cleanup", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "binding": { "enum": ["node", "python", "java", "dotnet"] },
    "level": { "enum": ["unit", "integration", "e2e"] },
    "candidateId": { "type": "string", "pattern": "^git-tree:[0-9a-f]{40,64}$" },
    "status": { "enum": ["pass", "fail", "blocked", "not_evaluated"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "minLength": 1 },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["executable", "args", "digest"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "pass" } }, "additionalProperties": false }
    },
    "negativeCanary": {
      "type": "object", "required": ["id", "status", "evidenceDigest"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "pass" }, "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "rawEvidence": {
      "type": "object", "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object", "required": ["status", "evidenceDigest"],
      "properties": { "status": { "const": "pass" }, "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "runner": {
      "type": "object",
      "required": ["os", "arch", "identityDigest"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "identityDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["packageSha256", "browserSha256", "driverSha256", "pairingDigest", "browserVersion", "driverVersion"],
      "properties": {
        "packageSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "browserSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "driverSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "pairingDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "browserVersion": { "type": "string", "minLength": 1 },
        "driverVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "level": { "const": "e2e" } }, "required": ["level"] },
      "then": { "required": ["runner", "artifact"], "properties": { "subject": { "const": "exact-packaged-browser-driver" } } }
    }
  ],
  "additionalProperties": true
}
