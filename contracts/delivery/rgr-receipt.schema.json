{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slybrowser.com/contracts/delivery/rgr-receipt.schema.json",
  "title": "SlyBrowser Red Green Refactor and cleanup receipt",
  "type": "object",
  "required": ["schemaVersion", "candidateId", "changeKind", "productionImplementationStartedAt", "phases", "cleanupAudit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^git-tree:[0-9a-f]{40,64}$" },
    "changeKind": { "enum": ["behavior", "historical", "non_behavior"] },
    "productionImplementationStartedAt": { "type": "string", "format": "date-time" },
    "phases": {
      "type": "object",
      "required": ["red", "green", "refactor"],
      "properties": {
        "red": { "$ref": "#/$defs/phase" },
        "green": { "$ref": "#/$defs/phase" },
        "refactor": {
          "allOf": [
            { "$ref": "#/$defs/phase" },
            {
              "type": "object",
              "required": ["levels"],
              "properties": {
                "levels": {
                  "type": "object",
                  "required": ["unit", "integration", "e2e"],
                  "additionalProperties": { "$ref": "#/$defs/level" }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cleanupAudit": {
      "type": "object",
      "required": ["status", "reviewedPaths", "referenceScanDigest", "documentationAuditDigest", "deletions"],
      "properties": {
        "status": { "const": "pass" },
        "reviewedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "referenceScanDigest": { "$ref": "#/$defs/digest" },
        "documentationAuditDigest": { "$ref": "#/$defs/digest" },
        "deletions": { "type": "array", "items": { "$ref": "#/$defs/deletion" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "phase": {
      "type": "object",
      "required": ["status", "exitCode", "observedAt", "commandDigest"],
      "properties": {
        "status": { "enum": ["pass", "fail", "historical_unavailable"] },
        "exitCode": { "type": "integer" },
        "observedAt": { "type": "string", "format": "date-time" },
        "commandDigest": { "$ref": "#/$defs/digest" },
        "failureFingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": true
    },
    "level": {
      "type": "object",
      "required": ["status", "evidenceDigest"],
      "properties": { "status": { "const": "pass" }, "evidenceDigest": { "$ref": "#/$defs/digest" } },
      "additionalProperties": true
    },
    "deletion": {
      "type": "object",
      "required": ["path", "reason", "rollback", "referenceEvidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "referenceEvidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
