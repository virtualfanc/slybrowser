{
  "schemaVersion": 1,
  "classificationDefault": "unclassified",
  "allow": [
    ".editorconfig",
    ".gitattributes",
    ".github/**",
    ".gitignore",
    ".npmrc",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-SCOPE.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARKS.md",
    "assets/**",
    "contracts/**",
    "docs/**",
    "eslint.config.mjs",
    "legal/**",
    "locales/**",
    "package.json",
    "packages/dotnet/**",
    "packages/java/**",
    "packages/node/**",
    "packages/python/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "scripts/**",
    "tests/**"
