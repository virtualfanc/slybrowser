    "docs/business-model-*.md",
    "docs/product-feedback-*.md",
    "governance/**",
    "internal/**",
    "legal/*-DRAFT.md",
    "memory/**",
    "node_modules/**",
    "packages/license-service/**",
    "planning/**",
    "scripts/release/Publish-ReleaseBundleToServer.ps1",
    "scripts/release/Smoke-PayNowWebhook.mjs",
    "scripts/release/Sync-ReleaseRepository.ps1",
    "website/**"
  ],
  "reviewRequired": [],
  "baseline": {
    "status": "unresolved",
    "decision": "The public allowlist intentionally excludes server-side license-service and website source. Existing tracked bytes under excluded paths are not blessed by this contract and must be handled by a separately authorized current-tree and Git-history boundary audit.",
    "historyRewriteAuthorized": false,
    "secretExposureConfirmed": false
  }
}
