    "PROJECT.md",
    "PROJECT_REQUIREMENTS.md",
    "PROJECT_STATUS.md",
    "ROADMAP.md",
    "artifacts/**",
    "docs/*-backlog.md",
    "docs/*-design-draft.md",
    "docs/*-plan.md",
    "docs/*-proposal.md",
    "docs/*-requirements.md",
